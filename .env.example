# ============================================================================
# AUGC Pipeline - variables de entorno
# Copiá este archivo a .env.local y ajustá los valores.
# NO pongas API keys ni service accounts: la autenticacion es por ADC (gcloud).
# ============================================================================

# Modo de proveedor:
#   mock   -> genera placeholders localmente, sin credenciales ni cuota (probar pipeline completo)
#   vertex -> llamadas reales a Vertex AI (requiere ADC configurado)
PROVIDER_MODE=mock

# --- Google Cloud / Vertex AI (solo necesario con PROVIDER_MODE=vertex) ---
# La identidad se resuelve por Application Default Credentials (ADC):
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# `global`, NO una region. Toda la familia Gemini 3.x (chat e imagen) devuelve 404
# en us-central1, us-east5 y europe-west4: existe SOLO en el endpoint global. Veo
# tambien funciona ahi (ciclo completo del LRO verificado). Ponerlo en una region
# hace fallar todos los modelos de abajo con 404 en cada job.
GOOGLE_CLOUD_LOCATION=global

# --- Modelos por defecto (tambien seleccionables desde la UI por proyecto) ---
# Verificados con requests reales contra el proyecto el 2026-08-27, en `global`.
#
# Chat:   gemini-3.6-flash  (unico en el selector)
#         Tambien responden, por si se quieren agregar: gemini-3.5-flash,
#         gemini-3.1-flash-lite, gemini-3.5-flash-lite. gemini-3.7-flash existe
#         pero contesto 429 (sin capacidad).
# Imagen: gemini-3.1-flash-image      Nano Banana 2, equilibrado  (~1.1 MB)
#         gemini-3-pro-image          Nano Banana Pro, mejor calidad (~1.3 MB)
#         gemini-3.1-flash-lite-image Nano Banana 2 Lite (~56 KB, calidad baja)
# Video:  veo-3.1-lite-generate-001 | veo-3.1-fast-generate-001 | veo-3.1-generate-001
#         Veo 3.1 es la linea mas nueva que existe: veo-3.2 y veo-4.0 dan 404.
LLM_MODEL=gemini-3.6-flash
IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_MODEL=veo-3.1-lite-generate-001

# Resolucion de video por defecto (720p | 1080p). Tambien se elige por video en la UI.
VIDEO_RESOLUTION=720p

# Cantidad de variantes por imagen (1-4). Solo aplica a imagenes.
IMAGE_VARIANTS=1

# --- Almacenamiento local (NADA de servicios externos) ---
# Carpeta donde quedan imagenes/clips/manifest por proyecto.
OUTPUT_DIR=./output
# Estado de proyectos y jobs (JSON local).
DATA_DIR=./data

# --- Pipeline (opcional) ---
PIPELINE_CONCURRENCY=2
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_BACKOFF_MS=1500
VEO_POLL_INTERVAL_MS=10000
VEO_POLL_TIMEOUT_MS=600000
PIPELINE_MAX_LOG=500

# --- Precios para la estimacion en la UI (opcional, solo informativo) ---
PRICE_IMAGE_USD=0.04
PRICE_VIDEO_PER_SEC_USD=0.5
PRICE_LLM_CALL_USD=0.02


# ============================================================================
# AUTH - obligatorio si la app no corre en localhost
#
# La app llama a Veo y a Nano Banana, que son de pago. Sin estas variables el
# login rechaza TODO y no entra nadie (falla cerrado, a proposito): una app de
# generacion facturable no puede quedar abierta porque falto una var.
# ============================================================================

# Secret con el que se firman las cookies de sesion. Generalo con:
#   openssl rand -hex 32
# Rotarlo invalida todas las sesiones abiertas (todos vuelven a loguearse).
AUTH_SECRET=

# Un usuario por variable: PASSWORD_<NOMBRE>. El nombre se normaliza a
# minusculas para el login, asi que PASSWORD_IVAN habilita al usuario "ivan".
# Agregar o sacar gente es tocar esto y reiniciar el proceso, sin recompilar.
# Sacar la var revoca el acceso al instante, aunque la cookie siga sin vencer.
# Generar cada una con:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 40; echo
PASSWORD_IVAN=
PASSWORD_LUCHO=

# Horas de vida de la sesion antes de tener que volver a entrar (default 72).
AUTH_SESSION_HOURS=72

# URL publica canonica. La usa el middleware para armar el redirect al login:
# sin esto, en el build standalone detras de un proxy el redirect sale a
# http://127.0.0.1:<puerto>/login y saca al usuario de la app.
# En local se puede dejar vacia.
NEXT_PUBLIC_SITE_URL=
